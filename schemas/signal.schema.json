{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Saasrelaunchdev/PicoGTMBrain/schemas/signal.schema.json",
  "title": "Signal",
  "description": "One entry of ops/signal-log.md, as exported to data/signals.json and as accepted by tools/brain.py signal and the MCP tool brain_log_signal.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "date",
    "type",
    "source",
    "verbatim",
    "disposition"
  ],
  "properties": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "type": {
      "type": "string",
      "enum": [
        "OBJECTION",
        "LANGUAGE",
        "PROOF",
        "STATUS",
        "COMPETITIVE",
        "SEGMENT",
        "CHANNEL",
        "LOSS",
        "RISK"
      ]
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "verbatim": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "type": "string"
    },
    "disposition": {
      "type": "string",
      "pattern": "^(NOISE|PATCH|AMEND|WATCH \\(\\d+/\\d+\\))$"
    },
    "routed_to": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    }
  }
}
