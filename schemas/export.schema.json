{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Saasrelaunchdev/PicoGTMBrain/schemas/export.schema.json",
  "title": "Generated data export",
  "description": "The envelope of every file in data/, generated from the Markdown ledgers by tools/brain.py export. Never edit data/ by hand.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "generated_from",
    "as_of",
    "items"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "features",
        "claims",
        "glossary",
        "decisions",
        "signals",
        "copy-bank",
        "manifest"
      ]
    },
    "generated_from": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "as_of": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "items": {
      "type": "array"
    }
  }
}
