{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Saasrelaunchdev/PicoGTMBrain/schemas/tripwires.schema.json",
  "title": "Decision reopen triggers",
  "type": "object",
  "required": [
    "version",
    "tripwires"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "integer"
    },
    "last_reviewed": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "tripwires": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "decision",
          "name",
          "when",
          "action"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^TW-D\\d+$"
          },
          "decision": {
            "type": "string",
            "pattern": "^D\\d+$"
          },
          "name": {
            "type": "string"
          },
          "when": {
            "type": "object",
            "description": "A condition: {metric, op, value}, {signals: {tag, window_days}, op, value}, {events: {type, where, window_days}, op, value}, or {all: [...]}, {any: [...]}."
          },
          "action": {
            "type": "string"
          }
        }
      }
    }
  }
}
